# Copy to .env.local for local development. Do not commit real project URLs,
# anon keys, service-role keys, private keys, wallet mnemonics, or RPC secrets.

VITE_APP_ENV=local
VITE_PUBLIC_SITE_URL=http://localhost:5173
# Browser API code must use same-origin /api routes only. Never expose direct
# function origins, anon keys, service-role keys, signer material, or private RPCs
# through VITE_* variables. A verified contract address is public configuration.

# Dev server and Vercel proxy only. Keep these server-side.
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key-from-supabase-start
CHAIN_1_RPC_URL=replace-with-server-side-ethereum-mainnet-rpc-url
CHAIN_11155111_RPC_URL=replace-with-server-side-ethereum-sepolia-rpc-url
CHAIN_8453_RPC_URL=replace-with-server-side-base-mainnet-rpc-url
CHAIN_84532_RPC_URL=replace-with-server-side-base-sepolia-rpc-url
CHAIN_4663_RPC_URL=replace-with-server-side-robinhood-mainnet-rpc-url
CHAIN_46630_RPC_URL=replace-with-server-side-robinhood-testnet-rpc-url
CHAIN_1_BOUNTY_ESCROW_ADDRESS=replace-after-contract-deployment
CHAIN_11155111_BOUNTY_ESCROW_ADDRESS=replace-after-contract-deployment
CHAIN_8453_BOUNTY_ESCROW_ADDRESS=replace-after-contract-deployment
CHAIN_84532_BOUNTY_ESCROW_ADDRESS=replace-after-contract-deployment
CHAIN_4663_BOUNTY_ESCROW_ADDRESS=replace-after-contract-deployment
CHAIN_46630_BOUNTY_ESCROW_ADDRESS=replace-after-contract-deployment
CHAIN_1_REQUIRED_CONFIRMATIONS=12
CHAIN_11155111_REQUIRED_CONFIRMATIONS=12
CHAIN_8453_REQUIRED_CONFIRMATIONS=12
CHAIN_84532_REQUIRED_CONFIRMATIONS=12
CHAIN_4663_REQUIRED_CONFIRMATIONS=12
CHAIN_46630_REQUIRED_CONFIRMATIONS=12

# Live escrow remains disabled until the contract stream, legal, security, and
# operations launch gates pass. ETH should be represented as WETH in ERC20-only
# flows.
VITE_ESCROW_ENABLED=false
VITE_CHAIN_1_BOUNTY_ESCROW_ADDRESS=
VITE_CHAIN_11155111_BOUNTY_ESCROW_ADDRESS=
VITE_CHAIN_8453_BOUNTY_ESCROW_ADDRESS=
VITE_CHAIN_84532_BOUNTY_ESCROW_ADDRESS=
VITE_CHAIN_4663_BOUNTY_ESCROW_ADDRESS=
VITE_CHAIN_46630_BOUNTY_ESCROW_ADDRESS=
VITE_DEFAULT_CHAIN_ID=84532
